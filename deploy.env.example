# Copy to deploy.env ON THE SERVER and fill in. Never commit deploy.env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Long random string: python3 -c 'import secrets;print(secrets.token_urlsafe(24))'
DC_ADMIN_PASSWORD=
# From: python -m spike.spike webhook-create --url https://YOUR_DOMAIN/webhooks/paypal --yes
PAYPAL_WEBHOOK_ID=
# Optional: enables the model-written drafts. Without it the app uses the offline fallback.
ANTHROPIC_API_KEY=
DC_MODEL=claude-haiku-5-5
